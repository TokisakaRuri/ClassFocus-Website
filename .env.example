LLM_API_KEY=replace-with-your-text-model-key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=150
LLM_RETRY_ATTEMPTS=2
LLM_ENABLE_THINKING=false

# Local API protection. Leave blank to use an automatically generated local token file.
CLASSFOCUS_API_TOKEN=
CLASSFOCUS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Path to the external DEIM project containing engine/core.
DEIM_REPO_PATH=C:/path/to/deim

# Visual review uses the same single Qwen3.5-9B model by default.
VISION_API_KEY=replace-with-your-vision-model-key
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen3.5-9B
VISION_FALLBACK_MODEL=
VISION_TIMEOUT_SECONDS=110
VISION_BATCH_SIZE=6
VISION_FORMAT_RETRY_ATTEMPTS=2
# Lower values retain more light-but-real S-S/S-O findings (range: 0.0-1.0).
VISION_OCCLUSION_MIN_CONFIDENCE=0.35
LLM_FORMAT_RETRY_ATTEMPTS=2
